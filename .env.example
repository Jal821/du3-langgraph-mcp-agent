# --- The model -------------------------------------------------------------
# Any OpenAI-compatible endpoint. Leave OPENAI_BASE_URL unset to talk to OpenAI
# itself; set it for a local LiteLLM proxy, LM Studio or Ollama.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=auto/best-fast

# Examples of other endpoints:
# OPENAI_BASE_URL=http://localhost:1234/v1     OPENAI_MODEL=<lm studio model>
# OPENAI_BASE_URL=http://localhost:11434/v1    OPENAI_MODEL=llama3.1
# (unset OPENAI_BASE_URL)                      OPENAI_MODEL=gpt-5.4-nano

# --- The remote MCP server -------------------------------------------------
# Optional. With a Tavily key the agent also loads Tavily's hosted MCP server
# over streamable HTTP and can search the live web. Without it the agent runs
# on the local catalogue server and Wikipedia only - fewer tools, still works.
# Free key: https://app.tavily.com
TAVILY_API_KEY=
